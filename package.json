    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.16",
    "@angular/platform-server": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@angular/ssr": "^21.2.14",
    "@ngrx/store": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
